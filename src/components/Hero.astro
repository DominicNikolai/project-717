---
interface Metric {
  label: string;
  value: string;
  accent: boolean;
}

interface DayBar {
  label: string;
  value: number;
}

const dayLabels = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];

const metrics: Metric[] = [
  { label: 'Promedio', value: '78.4', accent: false },
  { label: 'Máximo', value: '96.2', accent: true },
  { label: 'Mínimo', value: '61.8', accent: false }
];

const bars: DayBar[] = [
  { label: 'Lun', value: 72 },
  { label: 'Mar', value: 81 },
  { label: 'Mié', value: 68 },
  { label: 'Jue', value: 89 },
  { label: 'Vie', value: 94 }
];

const chartPoints = [
  { x: 0, y: 100 },
  { x: 70, y: 88 },
  { x: 135, y: 72 },
  { x: 200, y: 65 },
  { x: 255, y: 55 },
  { x: 315, y: 48 },
  { x: 375, y: 30 }
];

const linePath =
  'M0 100 C30 92 45 80 70 88 S110 105 135 72 S175 48 200 65 S230 88 255 55 S290 35 315 48 S350 72 375 30 S395 20 400 18';
---

<div class='analytics'>
  <div class='analytics__glow analytics__glow--cyan'></div>
  <div class='analytics__glow analytics__glow--violet'></div>

  <div class='analytics__head'>
    <div>
      <p class='analytics__eyebrow'>Performance</p>
      <h2 class='analytics__title'>Actividad semanal</h2>
    </div>

    <button type='button' class='analytics__menu' aria-label='Mas opciones'>
      ⋮
    </button>
  </div>

  <div class='analytics__score-row'>
    <div>
      <div class='analytics__score'>
        <span class='analytics__value'>84.6%</span>
        <span class='analytics__delta'>+12.8%</span>
      </div>
      <p class='analytics__caption'>respecto a la semana anterior</p>
    </div>

    <div class='analytics__ring'>
      <svg class='analytics__ring-svg' viewBox='0 0 64 64'>
        <circle class='analytics__ring-track' cx='32' cy='32' r='27'></circle>
        <circle
          class='analytics__ring-value'
          cx='32'
          cy='32'
          r='27'
          pathLength='100'></circle>
      </svg>
      <span class='analytics__ring-label'>85</span>
    </div>
  </div>

  <div class='analytics__chart'>
    <div class='analytics__grid'></div>

    <svg
      class='analytics__chart-svg'
      viewBox='0 0 400 130'
      preserveAspectRatio='none'
    >
      <defs>
        <linearGradient id='chartGradient' x1='0' y1='0' x2='0' y2='1'>
          <stop offset='0%' stop-color='#22d3ee' stop-opacity='0.35'></stop>
          <stop offset='100%' stop-color='#22d3ee' stop-opacity='0'></stop>
        </linearGradient>

        <filter id='glow' x='-20%' y='-40%' width='140%' height='180%'>
          <feGaussianBlur stdDeviation='3' result='coloredBlur'></feGaussianBlur>
          <feMerge>
            <feMergeNode in='coloredBlur'></feMergeNode>
            <feMergeNode in='SourceGraphic'></feMergeNode>
          </feMerge>
        </filter>
      </defs>

      <path class='analytics__area' d={`${linePath} L400 130 L0 130 Z`}></path>
      <path class='analytics__line' d={linePath}></path>

      <g class='analytics__dots'>
        {chartPoints.map(({ x, y }) => <circle cx={x} cy={y} r='4' />)}
      </g>
    </svg>
  </div>

  <div class='analytics__labels'>
    {dayLabels.map(day => <span>{day}</span>)}
  </div>

  <div class='analytics__foot'>
    <div class='analytics__live'>
      <span class='analytics__dot'></span>
      <span>Datos en tiempo real</span>
    </div>

    <button
      type='button'
      id='detailsBtn'
      class='analytics__details-btn'
      aria-expanded='false'
      aria-controls='detailsPanel'
    >
      Ver detalles →
    </button>
  </div>

  <div id='detailsPanel' class='analytics__panel'>
    <div class='analytics__panel-inner'>
      <div class='analytics__panel-body'>
        <div class='analytics__stats'>
          {
            metrics.map(({ label, value, accent }) => (
              <div class='analytics__stat'>
                <p class='analytics__stat-label'>{label}</p>
                <p class:list={['analytics__stat-value', accent && 'is-accent']}>
                  {value}
                </p>
              </div>
            ))
          }
        </div>

        <div class='analytics__bars'>
          {
            bars.map(({ label, value }, i) => (
              <div class='analytics__bar' style={`--i: ${i}`}>
                <div class='analytics__bar-main'>
                  <span class='analytics__bar-id'>{label}</span>
                  <div class='analytics__bar-track'>
                    <div class='analytics__bar-fill' style={`--v: ${value}`} />
                  </div>
                </div>
                <span class='analytics__bar-value'>{value}%</span>
              </div>
            ))
          }
        </div>

        <div class='analytics__trend'>
          <div>
            <p class='analytics__trend-title'>Tendencia positiva</p>
            <p class='analytics__trend-text'>
              Tu rendimiento aumento durante la semana.
            </p>
          </div>
          <span class='analytics__trend-arrow'>↗</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .analytics {
    --accent: #22d3ee;
    --accent-soft: oklch(from #22d3ee l c h / 0.14);
    --accent-soft-hover: oklch(from #22d3ee l c h / 0.35);
    --surface: #0b0f14;
    --ink: #fff;
    --ink-faint: oklch(60.8% 0.012 235 / 1);
    --ink-ghost: oklch(48.6% 0.011 235 / 1);
    --success: oklch(86.6% 0.166 163 / 1);

    position: relative;
    inline-size: min(100%, 24rem);
    padding: 1.5rem;
    overflow: hidden;
    border: 1px solid oklch(100% 0 0 / 0.1);
    border-radius: 1.5rem;
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 1rem 3rem oklch(0% 0 0 / 0.35);
    transition:
      translate 0.5s,
      box-shadow 0.5s;

    &:hover {
      translate: 0 -0.5rem;
      box-shadow: 0 1.5625rem 5rem oklch(0% 0 0 / 0.55);
    }

    &:hover .analytics__glow--cyan {
      background: var(--accent-soft-hover);
    }
  }

  .analytics__glow {
    position: absolute;
    inline-size: 12rem;
    block-size: 12rem;
    border-radius: 50%;
    filter: blur(3rem);
    pointer-events: none;
    transition: background 0.7s;
  }

  .analytics__glow--cyan {
    inset-block-start: -5rem;
    inset-inline-end: -5rem;
    background: var(--accent-soft);
  }

  .analytics__glow--violet {
    inset-block-end: -5rem;
    inset-inline-start: -5rem;
    background: oklch(from #8b5cf6 l c h / 0.15);
  }

  .analytics__head {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .analytics__eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--ink-ghost);
  }

  .analytics__title {
    margin-block-start: 0.25rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .analytics__menu {
    display: grid;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border: 1px solid oklch(100% 0 0 / 0.1);
    border-radius: 0.75rem;
    background: oklch(100% 0 0 / 0.05);
    color: var(--ink-faint);
    font-size: 1rem;
    line-height: 1;
    transition:
      rotate 0.3s,
      background 0.3s,
      color 0.3s;

    &:hover {
      rotate: 12deg;
      background: oklch(100% 0 0 / 0.1);
      color: var(--ink);
    }

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
  }

  .analytics__score-row {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-block-start: 1.75rem;
  }

  .analytics__score {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .analytics__value {
    font-size: clamp(2rem, 8vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .analytics__delta {
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    background: oklch(from var(--success) l c h / 0.1);
    color: var(--success);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .analytics__caption {
    margin-block-start: 0.5rem;
    font-size: 0.875rem;
    color: var(--ink-ghost);
    text-wrap: pretty;
  }

  .analytics__ring {
    position: relative;
    inline-size: 4rem;
    block-size: 4rem;
  }

  .analytics__ring-svg {
    inline-size: 100%;
    block-size: 100%;
    rotate: -90deg;
  }

  .analytics__ring-track,
  .analytics__ring-value {
    fill: none;
    stroke: currentColor;
    stroke-width: 5;
  }

  .analytics__ring-track {
    color: oklch(100% 0 0 / 0.05);
  }

  .analytics__ring-value {
    color: var(--accent);
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 15;
    animation: analytics-draw 1.4s 0.2s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .analytics__ring-label {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .analytics__chart {
    position: relative;
    z-index: 10;
    block-size: 8rem;
    margin-block-start: 2rem;
  }

  .analytics__grid {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to bottom,
      oklch(100% 0 0 / 0.2) 0 1px,
      transparent 1px calc(100% / 4)
    );
    pointer-events: none;
  }

  .analytics__chart-svg {
    position: relative;
    inline-size: 100%;
    block-size: 100%;
    overflow: visible;
  }

  .analytics__area {
    fill: url('#chartGradient');
  }

  .analytics__line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
    filter: url('#glow');
    stroke-dasharray: 520;
    animation: analytics-trace 2s 0.2s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .analytics__dots {
    fill: var(--surface);
    stroke: var(--accent);
    stroke-width: 2;
  }

  .analytics__labels {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    margin-block-start: 0.75rem;
    color: var(--ink-ghost);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .analytics__foot {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-start: 1.5rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid oklch(100% 0 0 / 0.05);
  }

  .analytics__live {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-ghost);
    font-size: 0.75rem;
  }

  .analytics__dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--success);
    animation: analytics-pulse 2s ease-in-out infinite;
  }

  .analytics__details-btn {
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 500;
    transition:
      color 0.3s,
      letter-spacing 0.3s;

    &:hover {
      color: oklch(from var(--accent) l c h / 0.75);
      letter-spacing: 0.02em;
    }

    &:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
      border-radius: 0.25rem;
    }
  }

  .analytics__panel {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows 0.5s ease-out,
      opacity 0.5s ease-out,
      visibility 0.5s;

    &.is-open {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
    }
  }

  .analytics__panel-inner {
    overflow: hidden;
  }

  .analytics__panel-body {
    margin-block-start: 1.25rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid oklch(100% 0 0 / 0.05);
  }

  .analytics__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin-block-end: 1.25rem;
  }

  .analytics__stat {
    padding: 0.75rem;
    border: 1px solid oklch(100% 0 0 / 0.05);
    border-radius: 0.75rem;
    background: oklch(100% 0 0 / 0.03);
  }

  .analytics__stat-label {
    color: var(--ink-ghost);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .analytics__stat-value {
    margin-block-start: 0.25rem;
    font-size: 1.125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;

    &.is-accent {
      color: var(--accent);
    }
  }

  .analytics__bars {
    display: grid;
    gap: 0.75rem;
  }

  .analytics__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .analytics__bar-main {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .analytics__bar-id {
    inline-size: 2rem;
    color: var(--ink-ghost);
    font-size: 0.75rem;
  }

  .analytics__bar-track {
    inline-size: 8rem;
    block-size: 0.375rem;
    overflow: hidden;
    border-radius: 999px;
    background: oklch(100% 0 0 / 0.05);
  }

  .analytics__bar-fill {
    inline-size: 0;
    block-size: 100%;
    border-radius: 999px;
    background: var(--accent);
    transition: inline-size 1s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 70ms);
  }

  .analytics__panel.is-open .analytics__bar-fill {
    inline-size: calc(var(--v) * 1%);
  }

  .analytics__bar-value {
    color: oklch(92% 0.004 235 / 1);
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .analytics__trend {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: 1.25rem;
    padding: 0.75rem;
    border: 1px solid oklch(from var(--success) l c h / 0.1);
    border-radius: 0.75rem;
    background: oklch(from var(--success) l c h / 0.05);
  }

  .analytics__trend-title {
    color: var(--success);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .analytics__trend-text {
    margin-block-start: 0.25rem;
    color: var(--ink-ghost);
    font-size: 0.6875rem;
    text-wrap: pretty;
  }

  .analytics__trend-arrow {
    color: var(--success);
    font-size: 1.125rem;
  }

  @keyframes analytics-draw {
    from {
      stroke-dashoffset: 100;
    }

    to {
      stroke-dashoffset: 15;
    }
  }

  @keyframes analytics-trace {
    from {
      stroke-dashoffset: 520;
    }

    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes analytics-pulse {
    50% {
      opacity: 0.25;
      scale: 0.85;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .analytics,
    .analytics *,
    .analytics__panel {
      animation: none;
      transition-duration: 0.01ms;
    }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('#detailsBtn');
  const panel = document.querySelector<HTMLElement>('#detailsPanel');

  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    panel?.classList.toggle('is-open', !open);
  });
</script>
